#version 430 core
#extension GL_ARB_bindless_texture : require

// dimension z for the wave length sample
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(r32ui, binding = 3) uniform uimage2D caustic_map[3]; // r,g,b at bindings 3,4,5

#include "shared/scence.glsl"

struct df_object {
	mat4 worldToModel;
	uvec2 texture_handle;
	vec4 df_scale;
	vec4 material;
	vec4 brdf;
	ivec4 type;
	float df_size;
};

layout(std430, binding = 2) buffer DistanceFieldHandles { df_object objects[]; };

// formula from paper
float g(float x, float mu, float s1, float s2) {
	float t = (x - mu) / (x < mu ? s1 : s2);
	return exp(-0.5 * t * t);
}

// CIE 1931 (Wyman, Sloan, Shirley 2013).
vec3 cieXYZ(float l) {
	return vec3(
		1.056 * g(l, 599.8, 37.9, 31.0) + 0.362 * g(l, 442.0, 16.0, 26.7) - 0.065 * g(l, 501.1, 20.4, 26.2),
		0.821 * g(l, 568.8, 46.9, 40.5) + 0.286 * g(l, 530.9, 16.3, 31.1),
		1.217 * g(l, 437.0, 11.8, 36.0) + 0.681 * g(l, 459.0, 26.0, 13.8));
}

//380-780 nm
vec3 wavelengthToRGB(float l) {
	const mat3 XYZ2RGB = mat3( 3.2406, -0.9689,  0.0557,    
	                          -1.5372,  1.8758, -0.2040,
	                          -0.4986,  0.0415,  1.0570);
	vec3 rgb = max(XYZ2RGB * cieXYZ(l), 0.0);
	return rgb / vec3(0.4403, 0.2884, 0.2732);
}

uniform vec3 groundMin, groundMax;
uniform vec3 lightPos, intensity;
uniform int photon_count, objects_count;
uniform float frame_seed;
uniform float accu_coeff = 0.05;

const float IOR[3] = float[](1.2, 1.3, 1.4);
const vec3 target = vec3(-1, 1.5, 1.6);

uint rngState;
float randf() {
	rngState = rngState * 1664525u + 1013904223u;
	return float(rngState >> 8) / float(1u << 24);
}
vec3 randomUnitVector() {
	float z = 1.0 - 2.0 * randf();
	float r = sqrt(max(0.0, 1.0 - z * z));
	float phi = 6.2831853 * randf();
	return vec3(r * cos(phi), r * sin(phi), z);
}

float sceneSDF(vec3 p, out int id) {
	float d = 1e4;
	for (int i = 0; i < objects_count; ++i) {
		vec3 q = (objects[i].worldToModel * vec4(p, 1.0)).xyz;
		float di = texture(sampler3D(objects[i].texture_handle), q / objects[i].df_scale.xyz).r;
		if (di < d) { 
			d = di; 
			id = i; 
		}
	}
	vec3 b = abs(p - vec3(3, 0, -5)) - vec3(4, 5, 1);
	float db = length(max(b, 0.0)) + min(max(b.x, max(b.y, b.z)), 0.0);
	if (db < d) { d = db; id = objects_count; }
	return d;
}
float sceneSDF(vec3 p) { int id; return sceneSDF(p, id); }

vec3 sceneNormal(vec3 p) {
	const vec2 h = vec2(0.02, 0);
	return normalize(vec3(sceneSDF(p + h.xyy) - sceneSDF(p - h.xyy),
	                      sceneSDF(p + h.yxy) - sceneSDF(p - h.yxy),
	                      sceneSDF(p + h.yyx) - sceneSDF(p - h.yyx)));
}

float march(vec3 ro, vec3 rd, out int id) {
	float tg = rd.y < 0.0 ? -ro.y / rd.y : 1e9; 
	float t = 0.0, d;
	int s = 0;
	do {
		d = abs(sceneSDF(ro + rd * t, id));
		t += d;
	} while (d > 1e-2 && ++s < 20 && t < tg);
	if (d < 1e-2 && t < tg) return t;
	if (t >= tg) { id = objects_count + 2; return tg; } 
	return -1.0;                                        
}

void splat(float wave_length, vec2 uv, float val) {
	vec2 fpos = uv * vec2(imageSize(caustic_map[0])) - 0.5;
	ivec2 p = ivec2(floor(fpos));
	vec2 f = fract(fpos);
	vec3 color = wavelengthToRGB(wave_length);

	for(int c = 0; c < 3; ++c){
		float fac = c == 0 ? color.r : (c == 1 ? color.g : color.b);
		imageAtomicAdd(caustic_map[c], p, uint(fac * val * (1 - f.x) * (1 - f.y)));
		imageAtomicAdd(caustic_map[c], p + ivec2(1, 0), uint(fac * val * f.x * (1 - f.y)));
		imageAtomicAdd(caustic_map[c], p + ivec2(0, 1), uint(fac * val * (1 - f.x) * f.y));
		imageAtomicAdd(caustic_map[c], p + ivec2(1, 1), uint(fac * val * f.x * f.y));
	}
}
void main() {
	int indx = int(gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x);
	if (indx >= photon_count) return;
	rngState = indx * 1973u + uint(frame_seed) * 9277u + 1u;

	float wave_lenght = randf(); // [0,1)

	float ior = mix(IOR[2], IOR[0], wave_lenght);

	// aim at the center of bbs
	vec3 aim = objects_count > 0
		? (inverse(objects[0].worldToModel) * vec4(0.5 * objects[0].df_scale.xyz, 1.0)).xyz
		: target;

	const vec2 tiles = vec2(0.01, 0.12); 
	vec3 w = normalize(aim - lightPos);
	vec3 u = normalize(cross(vec3(0, 0, 1), w)); 
	vec3 v = cross(w, u);
	vec3 dir0 = normalize(w + tiles.x * (2.0 * randf() - 1.0) * u
	                          + tiles.y * (2.0 * randf() - 1.0) * v);

	float flux = intensity.x * (4.0 * tiles.x * tiles.y) / float(photon_count);

	for (int c = 0; c < 1; ++c) { 
		vec3 ro = lightPos;
		vec3 rd = dir0;
		float tint = 1.0;
		bool refracted = false;

		for (int i = 0; i < 20; ++i) {
			int id;
			float t = march(ro, rd, id);
			if (t < 0.0) break;
			vec3 p = ro + rd * t;
			vec3 n = sceneNormal(p);
			bool inside = dot(n, rd) >= 0.0;
			if (inside) n = -n;

			if (id == objects_count + 2) { //splat
				vec2 uv = (p.xz - groundMin.xy) / (groundMax - groundMin).xy;
				if (refracted && all(greaterThan(uv, vec2(0))) && all(lessThan(uv, vec2(1))))
					splat(400 * wave_lenght + 380, uv, clamp(tint * flux * 1e5 * accu_coeff, 0.0, 1e7));
				break;
			}
			int type = id < objects_count ? objects[id].type.x : 1; 
			if (type == 1) {
				rd = reflect(rd, n);
				ro = p + n * 0.02;
				if (id == objects_count) tint *= 0.7;
			} else if (type == 3) { // dielectric
				float eta = inside ? ior : 1.0 / ior;
				float cs = min(dot(-rd, n), 1.0);
				rd = eta * sqrt(1.0 - cs * cs) > 1.0 ? reflect(rd, n) : refract(rd, n, eta);
				ro = p + rd * 0.05;
				refracted = true;
			} else break; 
		}
	}
}
