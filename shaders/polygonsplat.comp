#version 430 core
#extension GL_ARB_bindless_texture : require

#include "raytracing/sampling.glsl"
#include "raytracing/raytracing_arbiter.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct vert { vec4 pos; vec4 path; };
layout(std430, binding = 7) writeonly buffer splatted_list { vert splatted[]; };

uniform float refract_index;
uniform int grid_size;

int out_id;
vec3 init_dir;

bool onHit(inout RayState s, Hit h) {
	if (h.material == MAT_GROUND) {
		if (s.refracted) splatted[out_id] = vert(vec4(h.p, s.radiance), vec4(init_dir, s.path_hash));
		return false;
	}
	if (h.material == MAT_SPECULAR) {
		reflectRay(s, h);
		s.radiance *= h.brdf.r;
		s.path_hash = s.path_hash * 17.0 + 2.0;
		return true;
	}
	if (h.material == MAT_DIELECTRIC) {
		bool tir = refractRay(s, h, refract_index);
		s.path_hash = s.path_hash * 17.0 + (tir ? 1.0 : 0.0);
		return true;
	}
	return false;
}

void onMiss(inout RayState s) {}

void main() {
	ivec2 indx = ivec2(gl_GlobalInvocationID.xy);
	if (indx.x >= grid_size || indx.y >= grid_size) return;

	init_dir = octDecode(vec2(indx) / float(grid_size - 1));
	out_id = grid_size * indx.x + indx.y;
	splatted[out_id] = vert(vec4(0.0), vec4(init_dir, -1.0));

	RayState s = genRay(lightSurface(init_dir), init_dir, WAVELENGTH_MID);
	tracePath(s);
}
